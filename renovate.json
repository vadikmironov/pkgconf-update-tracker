{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "enabledManagers": ["custom.regex"],
    "minimumReleaseAge": "3 days",
    "statusCheckNames": {
        "minimumReleaseAge": null
    },
    "automergeStrategy": "squash",
    "customManagers": [
        {
            "customType": "regex",
            "description": "The upstream release that this repository tracks",
            "managerFilePatterns": ["/^upstream\\.json$/"],
            "matchStrings": ["\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
            "depNameTemplate": "pkgconf/pkgconf",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^pkgconf-(?<version>\\d+\\.\\d+\\.\\d+)$"
        }
    ],
    "packageRules": [
        {
            "description": "A patch release that passes the gate merges with no person",
            "matchDepNames": ["pkgconf/pkgconf"],
            "matchUpdateTypes": ["patch"],
            "automerge": true,
            "platformAutomerge": true
        },
        {
            "description": "A minor or a major release is porting work",
            "matchDepNames": ["pkgconf/pkgconf"],
            "matchUpdateTypes": ["minor", "major"],
            "automerge": false,
            "labels": ["manual-bump"]
        }
    ]
}
